# Copie para .env e preencha. O .env nunca é commitado.

# Chave da API da NVIDIA (https://build.nvidia.com)
NVIDIA_API_KEY=

# Modelo de visão usado na extração dos prints (ex.: um modelo multimodal do catálogo NVIDIA)
NVIDIA_VISION_MODEL=

# Opcionais (valores padrão abaixo)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_TIMEOUT_S=60
# NVIDIA_MAX_RETRIES=2
# NVIDIA_MAX_TOKENS=1024
# NVIDIA_CONCORRENCIA=2

# Recorte do painel do echo antes de enviar, em frações da imagem [x0, y0, x1, y1]
# ECHO_RECORTE=[0.55, 0.05, 1.0, 0.95]

# DATA_DIR=./data
# CACHE_DIR=./cache/vision
