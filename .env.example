# Copie para .env e preencha. O .env nunca é commitado.

# Chave da API da NVIDIA (https://build.nvidia.com)
NVIDIA_API_KEY=

# Modelo de visão usado na extração dos prints. Testado: nvidia/nemotron-3.5-super-vl-120b-a12b
# (lê bem PT-BR; raciocina antes de responder, então use NVIDIA_MAX_TOKENS=6144)
NVIDIA_VISION_MODEL=

# Opcionais (valores padrão abaixo)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_TIMEOUT_S=60
# NVIDIA_MAX_RETRIES=2
# NVIDIA_MAX_TOKENS=1024
# NVIDIA_CONCORRENCIA=2

# Recorte do painel do echo antes de enviar, em frações da imagem [x0, y0, x1, y1]
# ECHO_RECORTE=[0.55, 0.05, 1.0, 0.95]

# DATA_DIR=./data
# CACHE_DIR=./cache/vision

# Título exato da janela do jogo, para a captura por atalho (F8/F9).
# CAPTURA_TITULO_JANELA=Wuthering Waves

# Atalhos da captura. O jogo roda como administrador: rode o servidor como administrador também, senão as teclas
# não chegam com o jogo em foco. Se o jogo engolir as teclas F, use combinações com Win (ex.: Win+Shift+E).
# CAPTURA_TECLA_ECHO=F8
# CAPTURA_TECLA_PERSONAGEM=F9
# CAPTURA_TECLA_ANALISE=F10
